PORT=5000
DB_DIALECT=sqlite
DB_STORAGE=canteen.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=canteen_db
DB_USER=root
DB_PASS=
JWT_SECRET=canteen_super_secret_change_me_in_production

# ==============================================================================
# Google OAuth Configuration (Google Identity Services)
# Configure your Google Cloud OAuth 2.0 Web Client ID here.
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# SMTP Project Email Configuration (Gmail SMTP)
# 1. Enter your project email in MAIL_USERNAME
# 2. Generate a 16-letter App Password at https://myaccount.google.com/apppasswords
#    (requires 2-Step Verification enabled in Google Account)
# 3. Enter the 16-letter App Password in MAIL_PASSWORD
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-project-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM="Campus Canteen" <your-project-email@gmail.com>

